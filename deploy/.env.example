# Copy to deploy/.env (git-ignored) and fill in.
POSTGRES_USER=asana
POSTGRES_PASSWORD=change-me
POSTGRES_DB=asana

# At least 16 chars (the backend refuses to start otherwise), e.g. `openssl rand -hex 32`.
# Changing it logs everyone out.
JWT_SECRET=change-me-to-at-least-16-random-chars

# Public URL users open; used to build invite links (`${APP_URL}/invite/<token>`).
# Must be https in production: the session cookie is Secure when NODE_ENV=production.
APP_URL=http://localhost:8080

# IANA time zone for reports ("today", overdue, weeks start Monday). Default Asia/Jakarta.
APP_TIMEZONE=Asia/Jakarta

# Workspace that existing data moves into on the v1.2 upgrade, and that create-admin creates on an
# empty DB. Read only when it's created; rename it later in Workspace settings. Default Mekari.
DEFAULT_WORKSPACE_NAME=Mekari

# Fetch titles/images for attached links (SPEC §13). false = link cards without previews,
# e.g. when the server has no outbound internet. Default true.
LINK_PREVIEW_ENABLED=true

# The MCP server, so people can use Claude (claude.ai connector or Claude Code) with their work
# (SPEC §14). Needs APP_URL to be https and reachable from the internet with a stable hostname.
MCP_ENABLED=false

# Proxy hops that set X-Forwarded-For in front of the BE: 1 for this stack's nginx. Add one per
# extra proxy that also overwrites it (e.g. a load balancer); never more than really exist.
TRUST_PROXY_HOPS=1

# Host port nginx is published on.
HTTP_PORT=8080

# Path to the frontend repo checkout (relative to this deploy/ dir).
FE_CONTEXT=../../asana-clone-fe
