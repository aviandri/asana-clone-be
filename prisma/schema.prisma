generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectPrivacy {
  PUBLIC
  TEAM
  PRIVATE
}

enum ProjectView {
  LIST
  BOARD
  CALENDAR
}

enum ProjectRole {
  OWNER
  EDITOR
  COMMENTER
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum ActivityType {
  CREATED
  COMPLETED
  REOPENED
  ASSIGNED
  UNASSIGNED
  DUE_DATE_CHANGED
  MOVED_SECTION
  RENAMED
  PRIORITY_CHANGED
  DESCRIPTION_CHANGED
}

enum NotificationType {
  ASSIGNED
  COMMENTED
  COMPLETED
  MENTIONED
}

enum GoalStatus {
  NO_STATUS
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ACHIEVED
  PARTIAL
  MISSED
  DROPPED
}

enum GoalProgressSource {
  KEY_RESULTS
  SUB_GOALS
  PROJECTS
  MANUAL
}

enum KeyResultMetric {
  NUMBER
  PERCENT
  CURRENCY
  BOOLEAN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MEMBER)
  isActive     Boolean  @default(true)
  avatarColor  String
  createdAt    DateTime @default(now())

  invitesSent          Invite[]        @relation("InvitedBy")
  teamMemberships      TeamMember[]
  ownedProjects        Project[]       @relation("ProjectOwner")
  projectMemberships   ProjectMember[]
  assignedTasks        Task[]          @relation("TaskAssignee")
  createdTasks         Task[]          @relation("TaskCreator")
  followedTasks        TaskFollower[]
  comments             Comment[]
  activities           Activity[]
  notifications        Notification[]  @relation("NotificationRecipient")
  notificationsCreated Notification[]  @relation("NotificationActor")
  ownedGoals           Goal[]          @relation("GoalOwner")
  ownedKeyResults      KeyResult[]     @relation("KeyResultOwner")
  goalUpdates          GoalUpdate[]
}

model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  role        Role      @default(MEMBER)
  token       String    @unique
  invitedById String    @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())

  members  TeamMember[]
  projects Project[]
  goals    Goal[]
}

model TeamMember {
  teamId String @db.Uuid
  userId String @db.Uuid

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Project {
  id          String         @id @default(uuid()) @db.Uuid
  teamId      String         @db.Uuid
  ownerId     String         @db.Uuid
  name        String
  description String?
  color       String
  privacy     ProjectPrivacy @default(TEAM)
  archived    Boolean        @default(false)
  defaultView ProjectView    @default(LIST)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  team     Team            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  owner    User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members  ProjectMember[]
  sections  Section[]
  tasks     Task[]
  goalLinks GoalProject[]

  @@index([teamId])
}

model ProjectMember {
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(EDITOR)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Section {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  name      String
  position  Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String?   @db.Uuid
  sectionId   String?   @db.Uuid
  parentId    String?   @db.Uuid
  title       String
  description String?
  assigneeId  String?   @db.Uuid
  creatorId   String    @db.Uuid
  dueDate     DateTime? @db.Date
  startDate   DateTime? @db.Date
  priority    Priority  @default(NONE)
  completed   Boolean   @default(false)
  completedAt DateTime?
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Deleting a section moves its tasks to sectionId = null.
  section       Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent        Task?          @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks      Task[]         @relation("Subtasks")
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator       User           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  followers     TaskFollower[]
  comments      Comment[]
  activities    Activity[]
  notifications Notification[]

  @@index([projectId, sectionId, position])
  @@index([parentId])
  @@index([assigneeId])
}

model TaskFollower {
  taskId String @db.Uuid
  userId String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @db.Uuid
  authorId  String    @db.Uuid
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  taskId    String       @db.Uuid
  actorId   String       @db.Uuid
  type      ActivityType
  data      Json         @default("{}")
  createdAt DateTime     @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  actorId   String           @db.Uuid
  taskId    String?          @db.Uuid
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// --- Goals / OKRs (SPEC §10) -------------------------------------------------

model Goal {
  id             String             @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  ownerId        String             @db.Uuid
  /// Company-level goal. Mutually exclusive with teamId; neither = personal goal.
  isCompany      Boolean            @default(false)
  teamId         String?            @db.Uuid
  parentId       String?            @db.Uuid
  /// YYYY | YYYY-H1|H2 | YYYY-Q1..Q4
  timePeriod     String
  status         GoalStatus         @default(NO_STATUS)
  progressSource GoalProgressSource @default(KEY_RESULTS)
  manualProgress Float              @default(0)
  weight         Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  owner      User          @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  // Teams with goals can't be deleted (API returns 409), like teams with projects.
  team       Team?         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  // Deleting a goal detaches its children (parentId = null).
  parent     Goal?         @relation("GoalCascade", fields: [parentId], references: [id], onDelete: SetNull)
  children   Goal[]        @relation("GoalCascade")
  keyResults KeyResult[]
  projects   GoalProject[]
  updates    GoalUpdate[]

  @@index([parentId])
  @@index([teamId])
  @@index([timePeriod])
}

model KeyResult {
  id           String          @id @default(uuid()) @db.Uuid
  goalId       String          @db.Uuid
  title        String
  metricType   KeyResultMetric
  startValue   Float           @default(0)
  targetValue  Float
  currentValue Float           @default(0)
  unit         String?
  ownerId      String?         @db.Uuid
  position     Float           @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  owner User? @relation("KeyResultOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([goalId, position])
}

model GoalProject {
  goalId    String @db.Uuid
  projectId String @db.Uuid

  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([goalId, projectId])
  @@index([projectId])
}

model GoalUpdate {
  id        String     @id @default(uuid()) @db.Uuid
  goalId    String     @db.Uuid
  authorId  String     @db.Uuid
  status    GoalStatus
  /// Progress snapshot (0–100) when the update was posted.
  progress  Float
  body      String?
  createdAt DateTime   @default(now())

  goal   Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}
