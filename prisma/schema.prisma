generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TokenScope {
  READ
  WRITE
}

enum TokenSource {
  PAT
  OAUTH
}

enum OAuthClientSource {
  DCR
  CIMD
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  GUEST
}

enum ProjectPrivacy {
  PUBLIC
  TEAM
  PRIVATE
}

enum ProjectView {
  LIST
  BOARD
  CALENDAR
}

enum ProjectRole {
  OWNER
  EDITOR
  COMMENTER
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum ActivityType {
  CREATED
  COMPLETED
  REOPENED
  ASSIGNED
  UNASSIGNED
  DUE_DATE_CHANGED
  MOVED_SECTION
  RENAMED
  PRIORITY_CHANGED
  DESCRIPTION_CHANGED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
}

enum AttachmentKind {
  FILE
  LINK
}

enum LinkPreviewStatus {
  PENDING
  READY
  FAILED
}

enum NotificationType {
  ASSIGNED
  COMMENTED
  COMPLETED
  MENTIONED
}

enum GoalStatus {
  NO_STATUS
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ACHIEVED
  PARTIAL
  MISSED
  DROPPED
}

enum GoalProgressSource {
  KEY_RESULTS
  SUB_GOALS
  PROJECTS
  MANUAL
}

enum KeyResultMetric {
  NUMBER
  PERCENT
  CURRENCY
  BOOLEAN
}

// --- Workspaces (SPEC §12) ----------------------------------------------------

model Workspace {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  isOrganization Boolean  @default(false)
  /// Lowercase company domain; set iff isOrganization.
  domain         String?  @unique
  color          String
  createdAt      DateTime @default(now())

  members       WorkspaceMember[]
  lastUsedBy    User[]            @relation("LastWorkspace")
  invites       Invite[]
  teams         Team[]
  projects      Project[]
  tasks         Task[]
  goals         Goal[]
  notifications Notification[]
  attachments   Attachment[]
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  isActive    Boolean       @default(true)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  name            String
  passwordHash    String
  /// Global kill switch (create-admin / DB only). Workspace admins manage WorkspaceMember.isActive.
  isActive        Boolean  @default(true)
  avatarColor     String
  lastWorkspaceId String?  @db.Uuid
  createdAt       DateTime @default(now())

  lastWorkspace        Workspace?        @relation("LastWorkspace", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)
  workspaceMemberships WorkspaceMember[]

  invitesSent          Invite[]        @relation("InvitedBy")
  teamMemberships      TeamMember[]
  ownedProjects        Project[]       @relation("ProjectOwner")
  projectMemberships   ProjectMember[]
  assignedTasks        Task[]          @relation("TaskAssignee")
  createdTasks         Task[]          @relation("TaskCreator")
  followedTasks        TaskFollower[]
  comments             Comment[]
  activities           Activity[]
  notifications        Notification[]  @relation("NotificationRecipient")
  notificationsCreated Notification[]  @relation("NotificationActor")
  ownedGoals           Goal[]          @relation("GoalOwner")
  ownedKeyResults      KeyResult[]     @relation("KeyResultOwner")
  goalUpdates          GoalUpdate[]
  attachments          Attachment[]
  apiTokens            ApiToken[]
  oauthRequests        OAuthRequest[]
  oauthCodes           OAuthCode[]
  oauthRefreshes       OAuthRefresh[]
}

model Invite {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  invitedById String        @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Plus a partial unique index on (workspaceId, email) WHERE acceptedAt IS NULL, in raw SQL
  // (migration 20261018120000_invite_pending_unique): one pending invite per workspace and email.

  @@index([email])
  @@index([workspaceId])
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  members   TeamMember[]
  projects  Project[]
  goals     Goal[]

  @@index([workspaceId])
}

model TeamMember {
  teamId String @db.Uuid
  userId String @db.Uuid

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Project {
  id          String         @id @default(uuid()) @db.Uuid
  /// Always its team's workspace.
  workspaceId String         @db.Uuid
  teamId      String         @db.Uuid
  ownerId     String         @db.Uuid
  name        String
  description String?
  color       String
  privacy     ProjectPrivacy @default(TEAM)
  archived    Boolean        @default(false)
  defaultView ProjectView    @default(LIST)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  team      Team            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  owner     User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   ProjectMember[]
  sections  Section[]
  tasks     Task[]
  goalLinks GoalProject[]

  @@index([teamId])
  @@index([workspaceId])
}

model ProjectMember {
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(EDITOR)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Section {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  name      String
  position  Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  /// Set for every task; a project task always has its project's workspace.
  workspaceId String    @db.Uuid
  projectId   String?   @db.Uuid
  sectionId   String?   @db.Uuid
  parentId    String?   @db.Uuid
  title       String
  description String?
  assigneeId  String?   @db.Uuid
  creatorId   String    @db.Uuid
  dueDate     DateTime? @db.Date
  startDate   DateTime? @db.Date
  priority    Priority  @default(NONE)
  completed   Boolean   @default(false)
  completedAt DateTime?
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Deleting a section moves its tasks to sectionId = null.
  section       Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent        Task?          @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks      Task[]         @relation("Subtasks")
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator       User           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  followers     TaskFollower[]
  comments      Comment[]
  activities    Activity[]
  notifications Notification[]
  attachments   Attachment[]

  @@index([projectId, sectionId, position])
  @@index([parentId])
  @@index([assigneeId])
  @@index([workspaceId])
}

model TaskFollower {
  taskId String @db.Uuid
  userId String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @db.Uuid
  authorId  String    @db.Uuid
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([taskId, createdAt])
}

/// SPEC §13. Files live in the StorageDriver under `storageKey` (thumbnails at derived keys); rows
/// are deleted first and their files after the commit. Drafts belong to a comment being written.
model Attachment {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  taskId      String         @db.Uuid
  commentId   String?        @db.Uuid
  uploaderId  String         @db.Uuid
  kind        AttachmentKind
  draft       Boolean        @default(false)
  createdAt   DateTime       @default(now())

  // FILE
  name         String?
  mimeType     String?
  size         Int?
  storageKey   String? @unique
  sha256       String?
  width        Int?
  height       Int?
  hasThumbnail Boolean @default(false)

  // LINK
  url           String?
  title         String?
  description   String?
  siteName      String?
  provider      String?
  previewStatus LinkPreviewStatus?
  /// The title was typed by the user: a refreshed preview keeps it.
  titleFromUser Boolean            @default(false)
  iconKey       String?            @unique
  imageKey      String?            @unique

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([commentId])
  @@index([draft, createdAt])
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  taskId    String       @db.Uuid
  actorId   String       @db.Uuid
  type      ActivityType
  data      Json         @default("{}")
  createdAt DateTime     @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  userId      String           @db.Uuid
  actorId     String           @db.Uuid
  taskId      String?          @db.Uuid
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([workspaceId, userId, read])
}

// --- Goals / OKRs (SPEC §10) -------------------------------------------------

model Goal {
  id             String             @id @default(uuid()) @db.Uuid
  workspaceId    String             @db.Uuid
  title          String
  description    String?
  ownerId        String             @db.Uuid
  /// Company-level goal. Mutually exclusive with teamId; neither = personal goal.
  isCompany      Boolean            @default(false)
  teamId         String?            @db.Uuid
  parentId       String?            @db.Uuid
  /// YYYY | YYYY-H1|H2 | YYYY-Q1..Q4
  timePeriod     String
  status         GoalStatus         @default(NO_STATUS)
  progressSource GoalProgressSource @default(KEY_RESULTS)
  manualProgress Float              @default(0)
  weight         Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  owner      User          @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  // Teams with goals can't be deleted (API returns 409), like teams with projects.
  team       Team?         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  // Deleting a goal detaches its children (parentId = null).
  parent     Goal?         @relation("GoalCascade", fields: [parentId], references: [id], onDelete: SetNull)
  children   Goal[]        @relation("GoalCascade")
  keyResults KeyResult[]
  projects   GoalProject[]
  updates    GoalUpdate[]

  @@index([parentId])
  @@index([teamId])
  @@index([timePeriod])
  @@index([workspaceId])
}

model KeyResult {
  id           String          @id @default(uuid()) @db.Uuid
  goalId       String          @db.Uuid
  title        String
  metricType   KeyResultMetric
  startValue   Float           @default(0)
  targetValue  Float
  currentValue Float           @default(0)
  unit         String?
  ownerId      String?         @db.Uuid
  position     Float           @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  owner User? @relation("KeyResultOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([goalId, position])
}

model GoalProject {
  goalId    String @db.Uuid
  projectId String @db.Uuid

  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([goalId, projectId])
  @@index([projectId])
}

model GoalUpdate {
  id        String     @id @default(uuid()) @db.Uuid
  goalId    String     @db.Uuid
  authorId  String     @db.Uuid
  status    GoalStatus
  /// Progress snapshot (0–100) when the update was posted.
  progress  Float
  body      String?
  createdAt DateTime   @default(now())

  goal   Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

// --- SPEC §14: personal access tokens and OAuth for the MCP server -----------------------------
// Every secret is stored as its sha256 (hex): they are 32 random bytes, so no slow hash is needed.

/// A bearer token for /mcp: a PAT, or an OAuth access token (1 h, in an OAuthRefresh family).
model ApiToken {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  name          String
  source        TokenSource
  scope         TokenScope
  /// The first 12 characters (incl. the `mpat_` / `mpoa_` type prefix), for display.
  prefix        String
  tokenHash     String      @unique
  oauthClientId String?     @db.Uuid
  /// OAuth: the OAuthRefresh.family this access token was issued in.
  oauthFamily   String?     @db.Uuid
  createdAt     DateTime    @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthClient OAuthClient? @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([oauthFamily])
}

/// A registered OAuth client: by dynamic registration (DCR) or a client ID metadata document (CIMD, M11).
model OAuthClient {
  id           String            @id @default(uuid()) @db.Uuid
  /// Random for DCR; the metadata document's https URL for CIMD.
  clientId     String            @unique
  source       OAuthClientSource @default(DCR)
  name         String
  redirectUris String[]
  createdAt    DateTime          @default(now())
  lastUsedAt   DateTime?
  /// CIMD: when the metadata document was last fetched.
  cachedAt     DateTime?

  tokens    ApiToken[]
  requests  OAuthRequest[]
  codes     OAuthCode[]
  refreshes OAuthRefresh[]
}

/// A validated /oauth/authorize request waiting for the user's decision (10 min, M18). Bound to a user on decision.
model OAuthRequest {
  id            String     @id @default(uuid()) @db.Uuid
  clientId      String     @db.Uuid
  redirectUri   String
  codeChallenge String
  /// What was requested: READ = only `read`.
  scope         TokenScope
  resource      String
  state         String?
  expiresAt     DateTime
  decidedAt     DateTime?
  userId        String?    @db.Uuid
  createdAt     DateTime   @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// An authorization code (60 s, single use). `family` is set on exchange, so a reused code can revoke what it issued.
model OAuthCode {
  id            String     @id @default(uuid()) @db.Uuid
  codeHash      String     @unique
  clientId      String     @db.Uuid
  userId        String     @db.Uuid
  redirectUri   String
  codeChallenge String
  scope         TokenScope
  resource      String
  expiresAt     DateTime
  usedAt        DateTime?
  family        String?    @db.Uuid
  createdAt     DateTime   @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A rotating refresh token (30 d). One family per grant; reuse after rotation revokes the family (M20).
model OAuthRefresh {
  id        String     @id @default(uuid()) @db.Uuid
  tokenHash String     @unique
  prefix    String
  family    String     @db.Uuid
  clientId  String     @db.Uuid
  userId    String     @db.Uuid
  scope     TokenScope
  createdAt DateTime   @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([family])
  @@index([userId, revokedAt])
}
