NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Shared dev Postgres (embedded-postgres in ../devdb). Use 127.0.0.1, it listens on IPv4 only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/asana?connection_limit=5
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/asana_test?connection_limit=3
# At least 16 chars. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-dev-secret-change-me
# Frontend origin, used to build invite links.
APP_URL=http://localhost:5173
# Per-IP attempts/minute on login and accept-invite.
AUTH_RATE_LIMIT_MAX=10
# IANA zone for "today", goal periods and report bucketing.
APP_TIMEZONE=Asia/Jakarta
# Attachments (SPEC §13). Files live under STORAGE_DIR (docker: /data/attachments on the `attachments` volume).
STORAGE_DRIVER=disk
STORAGE_DIR=./data/attachments
# Per-file limit in bytes (100 MB) and uploads per user per 10 minutes.
MAX_UPLOAD_BYTES=104857600
UPLOAD_RATE_LIMIT_MAX=60
# Longest a whole request may take (ms). nginx's timeouts are per read/write, so this is the only total cap.
REQUEST_TIMEOUT_MS=900000
# Link previews (SPEC §13): fetched by the server (MekariProjectBot/1.0). false = links get previewStatus FAILED.
LINK_PREVIEW_ENABLED=true
# TESTS ONLY (refused in production): let previews reach private addresses and any port.
LINK_PREVIEW_ALLOW_PRIVATE=false
