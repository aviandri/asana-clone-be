NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Shared dev Postgres (embedded-postgres in ../devdb). Use 127.0.0.1, it listens on IPv4 only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/asana?connection_limit=5
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/asana_test?connection_limit=3
# At least 16 chars. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-dev-secret-change-me
# Frontend origin, used to build invite links.
APP_URL=http://localhost:5173
# Per-IP attempts/minute on login and accept-invite.
AUTH_RATE_LIMIT_MAX=10
